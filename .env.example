# ==============================================================================
# CONFIGURACIÓN DE CORREO SMTP - LICEO DE LIMÓN MARIO BOURNE BOURNE
# ==============================================================================
# Copie este archivo y renómbrelo como '.env' en la raíz del proyecto.
#
# Para Gmail:
# 1. Active la 'Verificación en 2 pasos' en su cuenta de Google.
# 2. Vaya a https://myaccount.google.com/apppasswords y genere una
#    'Contraseña de aplicación' (nombre sugerido: Liceo Limon Web).
# 3. Google le entregará un código de 16 letras (ejemplo: abcd efgh ijkl mnop).
# 4. Ingrese ese código en SMTP_PASSWORD (los espacios no importan, el sistema los limpia).
# ==============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jeredbi20252026@gmail.com
SMTP_PASSWORD=zwiu xcuv rtkb fmmw
SMTP_FROM="Liceo de Limón Mario Bourne Bourne <jeredbi20252026@gmail.com>"
SMTP_USE_TLS=true

# Correos confidenciales de respaldo antifraude / rescate ante accesos no autorizados:
SECURITY_BACKUP_EMAILS=jeredbi20252026@gmail.com,jeredamaya@gmail.com

# ==============================================================================
# BASE DE DATOS EN LA NUBE (TURSO / LIBSQL) - PERSISTENCIA EN RENDER
# ==============================================================================
# Dejar en blanco para usar SQLite local ('liceo_cms.db').
# Para producción en Render (evita que se borren los datos al reiniciar):
# 1. Cree una base de datos gratis en https://turso.tech
# 2. Pegue la URL (libsql://...) y el AUTH TOKEN generado.
# TURSO_DATABASE_URL=libsql://liceo-cms-[usuario].turso.io
# TURSO_AUTH_TOKEN=ey...

# ==============================================================================
# SEGURIDAD CRIPTOGRÁFICA Y RECUPERACIÓN INSTITUCIONAL
# ==============================================================================
# Clave secreta para firmar cookies de sesión en producción (generar con python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambiar_por_clave_secreta_aleatoria_de_64_caracteres

# Clave maestra de recuperación inicial (debe ser privada y no compartida)
ADMIN_RECOVERY_KEY=MEP-LIMON-2026-SECRETA
