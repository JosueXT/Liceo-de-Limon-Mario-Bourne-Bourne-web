#
# Para Gmail:
# 1. Active la 'Verificación en 2 pasos' en su cuenta de Google.
# 2. Vaya a https://myaccount.google.com/apppasswords y genere una
#    'Contraseña de aplicación' (nombre sugerido: Liceo Limon Web).
# 3. Google le entregará un código de 16 letras (ejemplo: abcd efgh ijkl mnop).
# 4. Ingrese ese código en SMTP_PASSWORD (los espacios no importan, el sistema los limpia).
# ==============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jeredbi20252026@gmail.com
SMTP_PASSWORD=zwiu xcuv rtkb fmmw
SMTP_FROM="Liceo de Limón Mario Bourne Bourne <jeredbi20252026@gmail.com>"
SMTP_USE_TLS=true

# Correos confidenciales de respaldo antifraude / rescate ante accesos no autorizados:
